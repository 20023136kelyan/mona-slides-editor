# Copy to `.env` and paste your keys. `.env` is git-ignored; this file is not,
# so never put real keys here.
#
# Neither key is needed to try the agent: connect OpenAI or Anthropic from the
# composer strip (OAuth, no key) and look / inspect / edit all work.

# Shared photo library, used by both the Photos panel and the agent's
# search_images tool. Free key from https://www.pexels.com/api/
# Without it the agent finds no images and the panel falls back to its
# bundled sample catalog.
PEXELS_API_KEY=

# Web research for the agent's web_search tool. https://exa.ai
# Without it the tool is not advertised to the model at all.
EXA_API_KEY=
