{
  "name": "@mona/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "package": "node build.mjs && npm run build -w @mona/web && electron-builder --config electron-builder.yml",
    "package:dir": "node build.mjs && npm run build -w @mona/web && electron-builder --config electron-builder.yml --dir"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@mona/agent-protocol": "0.0.0",
    "@mona/data-source": "0.0.0",
    "@mona/document-jobs": "0.0.0",
    "@mona/pptx-ingestion": "0.0.0",
    "@mona/pptx-writeback": "0.0.0",
    "@mona/presentation-core": "0.0.0",
    "@mona/project-core": "0.0.0",
    "@openai/codex": "^0.146.0",
    "fast-xml-parser": "5.10.1",
    "hfmath": "^0.0.2",
    "jszip": "3.10.1",
    "svg-pathdata": "^8.0.0",
    "tinycolor2": "1.6.0"
  },
  "devDependencies": {
    "@mona/test-fixtures": "0.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "vitest": "4.1.10"
  },
  "description": "Mona — a desktop presentation editor with a drawing-first agent.",
  "author": "Mona contributors"
}
